{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"],
        "strict": true,
        "skipLibCheck": true,
        "noEmitOnError": true
    },
    "include": ["src"]
}